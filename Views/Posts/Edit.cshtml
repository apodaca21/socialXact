@model SocialX.Models.Post

@{
    ViewData["Title"] = "Editar publicación";
}

<h2>Editar publicación</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="Content">Contenido</label>
        <textarea name="Content" class="form-control" maxlength="140" rows="3" required>@Model.Content</textarea>
        <small class="text-muted">Máximo 140 caracteres.</small>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
