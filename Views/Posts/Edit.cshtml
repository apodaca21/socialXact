@model SocialX.Models.Post
@{
    ViewData["Title"] = "Editar publicación";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <h2>Editar publicación</h2>
        <p class="text-muted">Sólo puedes editar publicaciones con menos de 5 minutos de antigüedad.</p>

        <form asp-action="Edit" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="mb-3">
                <label class="form-label">Contenido</label>
                <textarea name="content" class="form-control" rows="3" maxlength="140">@Model.Content</textarea>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>
