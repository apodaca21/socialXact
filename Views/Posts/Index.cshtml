@model IEnumerable<SocialX.Models.Post>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Inicio";
}

<h2 class="mb-3">SocialX - Feed</h2>

@if (SignInManager.IsSignedIn(User))
{
    <form asp-action="Create" method="post" class="mb-4">
        <div class="form-group">
            <label for="Content">¿Qué estás pensando?</label>
            <textarea id="Content" name="Content"
                      class="form-control"
                      maxlength="140"
                      rows="3"
                      required></textarea>
            <small class="text-muted">Máximo 140 caracteres.</small>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Publicar</button>
    </form>
}
else
{
    <p>
        <a asp-area="Identity" asp-page="/Account/Login">Inicia sesión</a>
        para crear publicaciones.
    </p>
}

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay publicaciones.</p>
}
else
{
    <ul class="list-group">
        @foreach (var post in Model)
        {
            var canEdit = false;
            if (SignInManager.IsSignedIn(User))
            {
                var currentUserId = UserManager.GetUserId(User);
                canEdit = post.UserId == currentUserId && post.CanEdit;
            }

            <li class="list-group-item">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <strong>@(post.User?.UserName ?? "Usuario")</strong>
                        <span class="text-muted">
                            · @post.CreatedAt.ToLocalTime().ToString("g")
                            @if (post.IsEdited)
                            {
                                <span>(editado)</span>
                            }
                        </span>
                    </div>
                    <div>
                        @if (canEdit)
                        {
                            <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary">
                                Editar
                            </a>
                        }
                        @{
                            var canDelete = false;
                            if (SignInManager.IsSignedIn(User))
                            {
                                var currentUserId = UserManager.GetUserId(User);
                                canDelete = post.UserId == currentUserId;
                            }
                        }
                        @if (canDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@post.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" 
                                        onclick="return confirm('¿Estás seguro de que deseas eliminar este post?');">
                                    Eliminar
                                </button>
                            </form>
                        }
                    </div>
                </div>
                <p class="mt-2 mb-0">@post.Content</p>
            </li>
        }
    </ul>
}
